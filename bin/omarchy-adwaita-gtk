def render_index(mode: str) -> str:
    return "\n".join(
        [
            f"# {MARKER}; do not edit.",
            "[X-GNOME-Metatheme]",
            f"Name={THEME_NAME}",
            f"Comment=Omarchy colours on the stock Adwaita base ({mode})",
            "Type=X-GNOME-Metatheme",
            f"GtkTheme={THEME_NAME}",
            "Encoding=UTF-8",
            "",
        ]
    )


def render_libadwaita_css(colors_file: Path, palette: dict[str, str], mode: str) -> str:
    """libadwaita semantic palette for ordinary libadwaita applications.

    This is delivered through GTK4's user stylesheet (user priority 800), the
    only layer that outranks libadwaita's own stylesheet. It deliberately
    defines exactly the same set of semantic variables as the Nautilus layer
    (70-omarchy-nautilus-palette.sh), which registers its provider at priority
    801: every variable set here is therefore overridden again inside Nautilus,
    so Nautilus keeps its existing palette byte for byte.
    """
    colours = build_mapping(palette)
    name_file = XDG_STATE_HOME / "omarchy/current/theme.name"
    theme_name = name_file.read_text(encoding="utf-8").strip() if name_file.exists() else "active"

    background = colours["background"]
    foreground = colours["foreground"]
    base = colours["base"]
    sidebar = colours["sidebar"]
    card = colours["card"]
    muted = colours["muted"]
    accent = colours["accent"]
    accent_fg = colours["accent_fg"]
    red = colours["red"]
    green = colours["green"]
    yellow = colours["yellow"]
    shade = 0.18 if mode == "light" else 0.36

    lines = [
        f"/* {MARKER}; do not edit. */",
        f"/* Source: {colors_file}",
        f"   Theme: {theme_name} (mode: {mode})",
        "   libadwaita semantic palette for ordinary libadwaita applications,",
        "   delivered at GTK user-CSS priority so it outranks libadwaita's own",
        "   stylesheet. Nautilus is unaffected: its own provider is registered at",
        "   user priority + 1 and re-declares every variable below.",
        "   Regenerated by omarchy-adwaita-gtk on every Omarchy theme change. */",
        "",
        f"@define-color window_bg_color {background};",
        f"@define-color window_fg_color {foreground};",
        f"@define-color view_bg_color {base};",
        f"@define-color view_fg_color {foreground};",
        f"@define-color headerbar_bg_color {sidebar};",
        f"@define-color headerbar_fg_color {foreground};",
        f"@define-color headerbar_backdrop_color {mix(sidebar, background, 0.5)};",
        f"@define-color headerbar_shade_color {rgba(muted, 0.36)};",
        f"@define-color headerbar_darker_shade_color {rgba(muted, 0.60)};",
        f"@define-color sidebar_bg_color {sidebar};",
        f"@define-color sidebar_fg_color {foreground};",
        f"@define-color sidebar_backdrop_color {background};",
        f"@define-color sidebar_shade_color {rgba(muted, 0.25)};",
        f"@define-color sidebar_border_color {rgba(muted, 0.36)};",
        f"@define-color secondary_sidebar_bg_color {mix(sidebar, background, 0.5)};",
        f"@define-color secondary_sidebar_fg_color {foreground};",
        f"@define-color secondary_sidebar_backdrop_color {mix(sidebar, background, 0.75)};",
        f"@define-color card_bg_color {card};",
        f"@define-color card_fg_color {foreground};",
        f"@define-color card_shade_color {rgba(muted, 0.25)};",
        f"@define-color dialog_bg_color {card};",
        f"@define-color dialog_fg_color {foreground};",
        f"@define-color popover_bg_color {card};",
        f"@define-color popover_fg_color {foreground};",
        f"@define-color thumbnail_bg_color {card};",
        f"@define-color thumbnail_fg_color {muted};",
        f"@define-color accent_bg_color {accent};",
        f"@define-color accent_fg_color {accent_fg};",
        f"@define-color accent_color {accent};",
        f"@define-color destructive_bg_color {red};",
        f"@define-color destructive_fg_color {readable_on(red)};",
        f"@define-color destructive_color {red};",
        f"@define-color success_bg_color {green};",
        f"@define-color success_fg_color {readable_on(green)};",
        f"@define-color success_color {green};",
        f"@define-color warning_bg_color {yellow};",
        f"@define-color warning_fg_color {readable_on(yellow)};",
        f"@define-color warning_color {yellow};",
        f"@define-color error_bg_color {red};",
        f"@define-color error_fg_color {readable_on(red)};",
        f"@define-color error_color {red};",
        f"@define-color shade_color rgba(0,0,0,{shade:.2f});",
        "".join(
            [
                "@define-color scrollbar_outline_color ",
                "rgba(255,255,255,0.12);" if mode == "dark" else "rgba(0,0,0,0.15);",
            ]
        ),
        "",
    ]
    return "\n".join(lines)


def render_gtk3_user_css(colors_file: Path, palette: dict[str, str], mode: str) -> str:
    """Palette-only GTK3 user stylesheet.

    Some GTK3 applications never see the selected theme: libhandy applications
    (GNOME Disks, Evince, Seahorse, ...) run HdyStyleManager, which selects
    Adwaita itself and layers libhandy's own stylesheet - with hard-coded
    Adwaita colours - at application priority on top of it. A GTK3 user
    stylesheet is loaded at user priority (800), above the theme (200) and any
    application stylesheet (600), so the palette below wins everywhere.

    Only colours are declared here: no padding, size, radius, border width or
    other geometry, so application-specific layout stays exactly as shipped.
    """
    colours = build_mapping(palette)
    name_file = XDG_STATE_HOME / "omarchy/current/theme.name"
    theme_name = name_file.read_text(encoding="utf-8").strip() if name_file.exists() else "active"

    background = colours["background"]
    foreground = colours["foreground"]
    base = colours["base"]
    sidebar = colours["sidebar"]
    card = colours["card"]
    muted = colours["muted"]
    accent = colours["accent"]
    accent_fg = colours["accent_fg"]
    border = colours["border"]
    red = colours["red"]
    green = colours["green"]
    yellow = colours["yellow"]

    lines = [
        f"/* {MARKER}; do not edit. */",
        f"/* Source: {colors_file}",
        f"   Theme: {theme_name} (mode: {mode})",
        "   GTK3 user stylesheet: the Omarchy palette at user priority (800),",
        "   above the theme (200) and above application stylesheets (600). It",
        "   exists for applications that never see the selected GTK theme -",
        "   libhandy apps such as GNOME Disks, Evince and Seahorse, whose",
        "   HdyStyleManager selects Adwaita itself and layers libhandy's own",
        "   stylesheet, with hard-coded Adwaita colours, on top of it.",
        "   Every rule below is a colour-only copy of the matching rule in this",
        "   theme: same selectors, same colour values, no geometry, no padding,",
        "   no size, shadow or icon properties. Applications that already use",
        "   the theme therefore resolve exactly the same values as before, while",
        "   applications that miss the theme receive the same palette.",
        "   Nautilus is a GTK4 application and never reads this file.",
        "   Regenerated by omarchy-adwaita-gtk on every Omarchy theme change. */",
        "",
    ]
    return "\n".join(lines) + render_gtk3_user_payload(colors_file, palette, mode)


# Colour-bearing declarations that are safe to lift out of a theme rule: they
# change how something looks, never how large or where it is.
USER_CSS_PROPERTIES = (
    # `background` is the shorthand Adwaita uses for its headerbars and a few
    # other surfaces (e.g. "background: #1b1b1b linear-gradient(...)"). It only
    # ever carries colour and image data - no layout - so it is safe to lift,
    # whereas shorthands such as `border` also carry widths and are skipped.
    "background",
    "background-color",
    "background-image",
    "color",
    "border-color",
    "border-top-color",
    "border-right-color",
    "border-bottom-color",
    "border-left-color",
    "outline-color",
    "caret-color",
    "-gtk-secondary-caret-color",
)


def colour_only_rules(css: str) -> str:
    """Keep only colour declarations, preserving each rule's selector."""
    rules = []
    for match in re.finditer(r"([^{}@][^{}]*)\{([^{}]*)\}", css, re.S):
        selector = " ".join(match.group(1).split())
        kept = []
        for declaration in match.group(2).split(";"):
            if ":" not in declaration:
                continue
            prop = declaration.split(":", 1)[0].strip()
            if prop in USER_CSS_PROPERTIES:
                kept.append(" ".join(declaration.split()))
        if kept:
            body = " ".join(f"{decl};" for decl in kept)
            rules.append(f"{selector} {{ {body} }}")
    return "\n".join(rules)


def render_gtk3_user_payload(colors_file: Path, palette: dict[str, str], mode: str) -> str:
    """The palette half of the GTK3 user stylesheet.

    A colour-only copy of the generated theme's own rules plus the theme's
    colour definitions, so values are identical to what theme users already
    resolve, with a few libhandy-specific additions for widgets whose colours
    libhandy hard-codes in its own stylesheet.
    """
    colours = build_mapping(palette)
    theme_css = render_css(colors_file, palette, mode)
    payload = theme_css.split("*/", 1)[1]
    defines = [line for line in payload.splitlines() if line.strip().startswith("@define-color")]

    extras = [
        "",
        "/* --- libhandy widgets whose colours libhandy hard-codes ------------ */",
        "row.expander list.nested > row {",
        f"  background-color: {mix(colours['background'], colours['base'], 0.5)};",
        f"  border-color: {colours['border']};",
        "}",
        "row.expander:checked image.expander-row-arrow {",
        f"  color: {colours['accent']};",
        "}",
        "row.expander image.expander-row-arrow:disabled {",
        f"  color: {colours['muted']};",
        "}",
        "",
    ]
    return "\n".join(defines) + "\n\n" + colour_only_rules(payload) + "\n" + "\n".join(extras)


def write_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        tmp.write_text(content, encoding="utf-8")
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            try:
                tmp.unlink()
            except OSError:
                pass


HOOK_TEMPLATE = """#!/bin/bash
# {marker}; do not edit.
#
# Rebuild the system-wide GTK theme from the freshly staged Omarchy palette
# after every `omarchy theme set`, and select it with the normal GSettings
# mechanism. Runs after 60-omarchy-gtk-accent.sh and
# 70-omarchy-nautilus-palette.sh, neither of which it touches.

set -u

"$HOME/.local/bin/omarchy-adwaita-gtk" --quiet
"""


def install_hook() -> None:
    """Keep the theme-set hook in place (never overwrite a foreign file)."""
    if HOOK_FILE.exists() and not is_generated(HOOK_FILE):
        warn(f"not touching foreign hook: {HOOK_FILE}")
        return
    write_atomic(HOOK_FILE, HOOK_TEMPLATE.format(marker=MARKER))
    HOOK_FILE.chmod(0o755)


def high_contrast_active() -> str:
    """Return why HighContrast is active (empty string when it is not)."""
    current = current_theme_name()
    if current.lower().startswith("highcontrast"):
        return current
    result = _gsettings("get", "org.gnome.desktop.a11y.interface", "high-contrast")
    if result is None:
        return ""
    if result.stdout.strip() == "true":
        return "org.gnome.desktop.a11y.interface high-contrast"
    return ""


def install_user_css(path: Path, backup: Path, content: str, label: str) -> str:
    """Install a generated user stylesheet, respecting accessibility and
    foreign files. Returns a short status string for reporting."""
    reason = high_contrast_active()
    if reason:
        # Accessibility first: a neutral marked file keeps HighContrast styling
        # instead of painting the Omarchy palette over it.
        write_atomic(
            path,
            f"/* {MARKER}; do not edit. */\n"
            f"/* HighContrast active ({reason}); palette not applied. */\n",
        )
        return "highcontrast"

    if path.exists() and not is_generated(path):
        if backup.exists():
            warn(f"not overwriting foreign {label} {path} (backup already present)")
            return "foreign"
        os.replace(path, backup)
        warn(f"existing {label} moved to {backup}")

    write_atomic(path, content)
    return "installed"


def _gsettings(*args: str) -> subprocess.CompletedProcess[str] | None:
    """Run gsettings, returning None when the tool is not installed."""
    try:
        return subprocess.run(
            ["gsettings", *args],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return None


def select_theme(name: str) -> str:
    """Select the theme. Returns 'selected', 'highcontrast' or 'unreachable'."""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return "unreachable"
    current = current_theme_name()
    if current.lower().startswith("highcontrast"):
        # Accessibility choice: never replace a HighContrast theme by force.
        warn(f"keeping {current} (HighContrast) instead of selecting {name}")
        return "highcontrast"
    result = _gsettings("set", "org.gnome.desktop.interface", "gtk-theme", name)
    if result is None:
        warn("gsettings not available; theme written but not selected")
        return "unreachable"
    if result.returncode != 0:
        warn(f"could not select {name}: {result.stderr.strip()}")
        return "unreachable"
    return "selected"


def current_theme_name() -> str:
    result = _gsettings("get", "org.gnome.desktop.interface", "gtk-theme")
    if result is None:
        return ""
    return result.stdout.strip().strip("'")


def apply(colors_file: Path, quiet: bool) -> int:
    palette = resolve_palette(colors_file)
    mode = theme_mode(colors_file)
    css = render_css(colors_file, palette, mode)
    css4 = render_gtk4_css(colors_file, palette, mode)

    if THEME_DIR.exists() and not is_generated(THEME_CSS):
        backup = THEME_DIR.with_name(THEME_DIR.name + BACKUP_SUFFIX)
        if backup.exists():
            backup = backup.with_name(backup.name + "." + time.strftime("%Y%m%d%H%M%S"))
        os.replace(THEME_DIR, backup)
        warn(f"existing foreign theme moved to {backup}")

    write_atomic(THEME_CSS, css)
    write_atomic(THEME_CSS4, css4)
    write_atomic(THEME_INDEX, render_index(mode))
    install_hook()
    libadwaita_status = install_user_css(
        USER_CSS4,
        USER_CSS4_BACKUP,
        render_libadwaita_css(colors_file, palette, mode),
        "libadwaita palette",
    )
    gtk3_status = install_user_css(
        USER_CSS3,
        USER_CSS3_BACKUP,
        render_gtk3_user_css(colors_file, palette, mode),
        "GTK3 palette",
    )
    write_atomic(
        STATE_FILE,
        json.dumps(
            {
                "theme": THEME_NAME,
                "mode": mode,
                "source": str(colors_file),
                "updated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            },
            indent=1,
        )
        + "\n",
    )

    selected = select_theme(THEME_NAME)
    if not quiet:
        print(f"wrote {THEME_CSS}")
        print(f"wrote {THEME_CSS4}")
        print(f"wrote {THEME_INDEX}")
        if libadwaita_status == "installed":
            print(f"wrote {USER_CSS4} (libadwaita palette)")
        elif libadwaita_status == "highcontrast":
            print(f"HighContrast active: wrote a neutral {USER_CSS4}")
        else:
            print(f"left existing {USER_CSS4} untouched")
        if gtk3_status == "installed":
            print(f"wrote {USER_CSS3} (GTK3 palette for libhandy-style apps)")
        elif gtk3_status == "highcontrast":
            print(f"HighContrast active: wrote a neutral {USER_CSS3}")
        else:
            print(f"left existing {USER_CSS3} untouched")
        if selected == "selected":
            print(f"selected gtk-theme={THEME_NAME}")
        elif selected == "highcontrast":
            print("kept the HighContrast theme selected; generated theme written")
        else:
            print("gsettings not reachable; theme written but not selected")
    return 0


def restore() -> int:
    if THEME_DIR.exists():
        if is_generated(THEME_CSS) or not THEME_CSS.exists():
            shutil.rmtree(THEME_DIR)
            print(f"removed {THEME_DIR}")
        else:
            warn(f"kept non-generated theme directory: {THEME_DIR}")
    else:
        print(f"theme directory already absent: {THEME_DIR}")

    backup = THEME_DIR.with_name(THEME_DIR.name + BACKUP_SUFFIX)
    if backup.exists() and not THEME_DIR.exists():
        os.replace(backup, THEME_DIR)
        print(f"restored {backup} -> {THEME_DIR}")

    if STATE_FILE.exists():
        STATE_FILE.unlink()
        print(f"removed {STATE_FILE}")

    if USER_CSS4.exists():
        if is_generated(USER_CSS4):
            USER_CSS4.unlink()
            print(f"removed {USER_CSS4}")
        else:
            warn(f"kept non-generated file: {USER_CSS4}")
    if USER_CSS4_BACKUP.exists() and not USER_CSS4.exists():
        os.replace(USER_CSS4_BACKUP, USER_CSS4)
        print(f"restored {USER_CSS4_BACKUP} -> {USER_CSS4}")

    if USER_CSS3.exists():
        if is_generated(USER_CSS3):
            USER_CSS3.unlink()
            print(f"removed {USER_CSS3}")
        else:
            warn(f"kept non-generated file: {USER_CSS3}")
    if USER_CSS3_BACKUP.exists() and not USER_CSS3.exists():
        os.replace(USER_CSS3_BACKUP, USER_CSS3)
        print(f"restored {USER_CSS3_BACKUP} -> {USER_CSS3}")

    if HOOK_FILE.exists() and is_generated(HOOK_FILE):
        HOOK_FILE.unlink()
        print(f"removed {HOOK_FILE}")
    elif HOOK_FILE.exists():
        warn(f"kept non-generated hook: {HOOK_FILE}")

    mode = theme_mode(COLORS_FILE) if COLORS_FILE.exists() else "dark"
    fallback = "Adwaita" if mode == "light" else "Adwaita-dark"
    if current_theme_name() == THEME_NAME:
        if select_theme(fallback) == "selected":
            print(f"gtk-theme restored to {fallback}")
        else:
            warn(f"gsettings not reachable; set gtk-theme back to {fallback} manually")
    return 0


def status() -> int:
    mode = theme_mode(COLORS_FILE) if COLORS_FILE.exists() else "unknown"
    print(f"theme dir     : {THEME_DIR} ({'present' if THEME_CSS.exists() else 'missing'})")
    print(f"hook          : {HOOK_FILE} ({'present' if HOOK_FILE.exists() else 'missing'})")
    print(f"gtk-theme     : {current_theme_name() or 'unknown'}")
    print(f"omarchy mode  : {mode}")
    if STATE_FILE.exists():
        print("state         : " + STATE_FILE.read_text(encoding="utf-8").strip().replace("\n", " "))
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="omarchy-adwaita-gtk")
    parser.add_argument("--colors-file", default=str(COLORS_FILE))
    parser.add_argument("--stdout", action="store_true", help="print the generated CSS")
    parser.add_argument("--status", action="store_true", help="show what is installed")
    parser.add_argument("--restore", action="store_true", help="remove what this tool installed")
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args(argv)

    if args.status:
        return status()
    if args.restore:
        return restore()

    colors_file = Path(args.colors_file)
    if args.stdout:
        palette = resolve_palette(colors_file)
        sys.stdout.write(render_css(colors_file, palette, theme_mode(colors_file)))
        return 0
    return apply(colors_file, args.quiet)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
