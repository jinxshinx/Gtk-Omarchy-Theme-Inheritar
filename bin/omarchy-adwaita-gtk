#!/usr/bin/env python3
"""Build a system-wide Omarchy GTK theme for ordinary GTK applications.

The active Omarchy palette (colors.toml, resolved through omarchy-theme-color)
is layered onto the stock Adwaita stylesheet, so every ordinary GTK3
application inherits Omarchy colours while keeping Adwaita geometry, controls,
states and accessibility behaviour. Nothing is rebuilt from scratch and no
widget styling is redefined.

Generated files (all clearly marked, all under the user's home):

    ~/.local/share/themes/Omarchy-Adwaita/gtk-3.0/gtk.css
    ~/.local/share/themes/Omarchy-Adwaita/index.theme

The theme is selected with the normal GSettings mechanism
(org.gnome.desktop.interface gtk-theme) - GTK_THEME is not used, so the
selection stays visible to every desktop tool and remains a normal theme.

Deliberately NOT touched:

  * ~/.config/gtk-3.0/gtk.css and ~/.config/gtk-4.0/gtk.css (no global CSS
    injection; Nautilus and other GTK4 apps must not inherit anything from a
    file like that)
  * Nautilus theming (~/.cache/omarchy/gtk/nautilus.css and its extensions)
  * Lutris (no Lutris-specific files, hooks or environment)
  * system files (/usr/share/themes, /usr/share/omarchy, packages)

libadwaita applications (Nautilus, GNOME apps) replace the GTK theme with
their own "Adwaita-empty" theme internally, so they are intentionally
unaffected; they keep their existing accent-color integration from
60-omarchy-gtk-accent.sh.

Usage:

    omarchy-adwaita-gtk             # generate/refresh the theme and select it
    omarchy-adwaita-gtk --stdout    # print the generated CSS
    omarchy-adwaita-gtk --status    # show what is installed
    omarchy-adwaita-gtk --restore   # remove everything this tool installed
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

PROJECT = "Gtk-Omarchy-Theme-Inheritar"
THEME_NAME = "Omarchy-Adwaita"
MARKER = f"Generated by {PROJECT} (omarchy-adwaita-gtk)"
# Files written by earlier revisions of this tool are still recognised, so an
# installation can be upgraded in place without treating them as foreign.
LEGACY_MARKERS = ("Generated by omarchy-adwaita-gtk",)
BACKUP_SUFFIX = ".pre-omarchy-adwaita"
RESOLVER = "/usr/share/omarchy/bin/omarchy-theme-color"

HOME = Path.home()
XDG_DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
XDG_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")

THEME_DIR = XDG_DATA_HOME / "themes" / THEME_NAME
THEME_CSS = THEME_DIR / "gtk-3.0" / "gtk.css"
THEME_CSS4 = THEME_DIR / "gtk-4.0" / "gtk.css"
THEME_INDEX = THEME_DIR / "index.theme"
XDG_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
# GTK4's user stylesheet: the only mechanism that outranks libadwaita's own
# palette (libadwaita loads its stylesheet at application priority, and forces
# the theme name to "Adwaita-empty", so a theme directory cannot reach it).
USER_CSS4 = XDG_CONFIG_HOME / "gtk-4.0" / "gtk.css"
USER_CSS4_BACKUP = USER_CSS4.with_name(USER_CSS4.name + BACKUP_SUFFIX)
# GTK3 user stylesheet. Needed for applications that use their own stylesheet at
# application priority and therefore never see the selected GTK theme - most
# notably libhandy apps (GNOME Disks, Evince, Seahorse, ...), whose
# HdyStyleManager loads a libhandy stylesheet with hard-coded Adwaita colours.
# A GTK3 user stylesheet is loaded at user priority (800), above both the theme
# (200) and the application (600). Nautilus cannot be affected: it is a GTK4
# application and GTK4 never reads this file.
USER_CSS3 = XDG_CONFIG_HOME / "gtk-3.0" / "gtk.css"
USER_CSS3_BACKUP = USER_CSS3.with_name(USER_CSS3.name + BACKUP_SUFFIX)
STATE_FILE = XDG_STATE_HOME / "omarchy-adwaita-gtk" / "state.json"
HOOK_FILE = HOME / ".config/omarchy/hooks/theme-set.d/80-omarchy-adwaita-gtk.sh"
COLORS_FILE = XDG_STATE_HOME / "omarchy/current/theme/colors.toml"

DARK_BASE = "/org/gtk/libgtk/theme/Adwaita/gtk-contained-dark.css"
LIGHT_BASE = "/org/gtk/libgtk/theme/Adwaita/gtk-contained.css"
GTK4_DARK_BASE = "/org/gtk/libgtk/theme/Default/Default-dark.css"
GTK4_LIGHT_BASE = "/org/gtk/libgtk/theme/Default/Default-light.css"

# Adwaita's stylesheet refers to its indicator/scale artwork with paths relative
# to itself ("assets/check-symbolic.svg"). In the stock theme the stylesheet
# lives *inside* libgtk's GResource, so those relative paths resolve there. Our
# theme is a file, so the same paths would point at a non-existent directory and
# GTK would paint its red "broken image" placeholder over the widget - which is
# what turned checked checkboxes and radios into solid red blocks. Point the
# references back at libgtk's bundled assets instead.
GTK3_ASSET_PREFIX = "/org/gtk/libgtk/theme/Adwaita/assets/"
GTK4_ASSET_PREFIX = "/org/gtk/libgtk/theme/Default/assets/"

# Text-ish CSS properties: their colours are mapped with the foreground table,
# every other property uses the surface table. That keeps things like
# "background-color: white" (Adwaita light base) and "color: white" (text on a
# selected row) from being mapped to the same wrong value.
FOREGROUND_PROPERTIES = {"color", "-gtk-secondary-caret-color"}

# Adwaita defines that carry text meaning rather than a surface.
FOREGROUND_DEFINES = {
    "theme_fg_color",
    "theme_text_color",
    "theme_unfocused_fg_color",
    "theme_unfocused_text_color",
    "insensitive_fg_color",
    "unfocused_insensitive_color",
    "wm_title",
    "wm_unfocused_title",
}


def warn(message: str) -> None:
    print(f"warning: {message}", file=sys.stderr)


def is_generated(path: Path) -> bool:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    return any(marker in text for marker in (MARKER, *LEGACY_MARKERS))


def resolve_palette(colors_file: Path) -> dict[str, str]:
    """Return every resolved colour key for the active theme."""
    if not colors_file.exists():
        raise SystemExit(f"colours file not found: {colors_file}")
    resolver = RESOLVER if Path(RESOLVER).exists() else shutil.which("omarchy-theme-color")
    if not resolver:
        raise SystemExit("omarchy-theme-color not found; cannot resolve the palette")
    try:
        result = subprocess.run(
            [resolver, "--file", str(colors_file), "--all"],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise SystemExit(f"cannot run {resolver}: {exc.strerror}") from exc
    if result.returncode != 0:
        raise SystemExit(f"omarchy-theme-color failed: {result.stderr.strip()}")
    palette: dict[str, str] = {}
    for line in result.stdout.splitlines():
        if "\t" not in line:
            continue
        key, value = line.split("\t", 1)
        palette[key.strip()] = value.strip()
    if not palette:
        raise SystemExit("omarchy-theme-color returned an empty palette")
    return palette


def theme_mode(colors_file: Path) -> str:
    resolver = RESOLVER if Path(RESOLVER).exists() else shutil.which("omarchy-theme-color")
    if resolver:
        try:
            result = subprocess.run(
                [resolver, "--file", str(colors_file), "mode"],
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError:
            return "dark"
        mode = result.stdout.strip().lower()
        if mode in ("light", "dark"):
            return mode
    return "dark"


def hex_to_rgb(value: str) -> tuple[int, int, int] | None:
    value = value.strip().lstrip("#")
    if len(value) == 3:
        value = "".join(ch * 2 for ch in value)
    if len(value) != 6:
        return None
    try:
        return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]
    except ValueError:
        return None


def luminance(value: str) -> float:
    rgb = hex_to_rgb(value)
    if rgb is None:
        return 0.0
    r, g, b = (channel / 255 for channel in rgb)

    def linear(channel: float) -> float:
        return channel / 12.92 if channel <= 0.03928 else ((channel + 0.055) / 1.055) ** 2.4

    return 0.2126 * linear(r) + 0.7152 * linear(g) + 0.0722 * linear(b)


def readable_on(background: str, dark: str = "#000000", light: str = "#ffffff") -> str:
    """Pick the more readable of two foregrounds for a background colour."""
    return dark if luminance(background) > 0.5 else light


def pick(palette: dict[str, str], *keys: str, fallback: str = "#808080") -> str:
    for key in keys:
        value = palette.get(key)
        if value and hex_to_rgb(value):
            return value if value.startswith("#") else f"#{value}"
    return fallback


def rgba(value: str, alpha: float) -> str:
    rgb = hex_to_rgb(value)
    if rgb is None:
        return value
    r, g, b = rgb
    return f"rgba({r},{g},{b},{alpha:.2f})"


def mix(first: str, second: str, amount: float) -> str:
    """Blend two colours, amount=0 -> first, amount=1 -> second."""
    a, b = hex_to_rgb(first), hex_to_rgb(second)
    if a is None or b is None:
        return first
    blended = tuple(round(x + (y - x) * amount) for x, y in zip(a, b))
    return "#%02x%02x%02x" % blended


def load_base_css(mode: str) -> str:
    """Read the stock Adwaita stylesheet that ships inside GTK3."""
    return load_resource(LIGHT_BASE if mode == "light" else DARK_BASE, "libgtk-3")


LIBRARY_PATHS = {
    "libgtk-3": ("/usr/lib/libgtk-3.so.0", "/usr/lib64/libgtk-3.so.0",
                 "/usr/lib/x86_64-linux-gnu/libgtk-3.so.0"),
    "libgtk-4": ("/usr/lib/libgtk-4.so.1", "/usr/lib64/libgtk-4.so.1",
                 "/usr/lib/x86_64-linux-gnu/libgtk-4.so.1"),
}


_GI_EXTRACTOR = (
    "import sys\n"
    "import gi\n"
    "gi.require_version('Gtk', {version!r})\n"
    "from gi.repository import Gio, Gtk  # noqa: F401 - loads libgtk, registers its GResource\n"
    "data = Gio.resources_lookup_data({resource!r}, Gio.ResourceLookupFlags.NONE)\n"
    "open(sys.argv[1], 'wb').write(data.get_data())\n"
)


def _resource_via_gi(resource: str, version: str) -> str | None:
    """Read a resource with PyGObject, in a fresh interpreter.

    PyGObject pins a process to one GTK version - Gtk 3.0 or Gtk 4.0 may be
    loaded, never both - so the GTK4 stylesheet can no longer be read from the
    interpreter that already loaded Gtk 3.0 for the GTK3 stylesheet. A child
    process per lookup keeps the PyGObject path usable for both, without
    requiring the `gresource` command line tool. The child writes to a
    temporary file rather than stdout, so Python startup hooks a user may have
    (sitecustomize/usercustomize) cannot corrupt the stylesheet.
    """
    handle, temp = tempfile.mkstemp(prefix="omarchy-adwaita-gtk-", suffix=".css")
    os.close(handle)
    try:
        result = subprocess.run(
            [sys.executable, "-c",
             _GI_EXTRACTOR.format(version=version, resource=resource), temp],
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            return None
        data = Path(temp).read_bytes()
    except OSError:
        return None
    finally:
        try:
            os.unlink(temp)
        except OSError:
            pass
    if not data.strip():
        return None
    return data.decode("utf-8", errors="replace")


def load_resource(resource: str, library: str) -> str:
    """Read a stylesheet out of a GTK library's GResource bundle.

    PyGObject is tried first (no external tool required), the ``gresource``
    command line tool is only a secondary fallback, and its absence is handled
    instead of raising. Nothing in this function invokes a missing program.
    """
    version = "4.0" if library == "libgtk-4" else "3.0"
    css = _resource_via_gi(resource, version)
    if css:
        return css
    paths = [lib for lib in LIBRARY_PATHS[library] if Path(lib).exists()]
    if not paths:
        raise SystemExit(
            f"cannot find {library} (looked in {', '.join(LIBRARY_PATHS[library])}); "
            f"is GTK{version.split('.')[0]} installed?"
        )
    for lib in paths:
        try:
            result = subprocess.run(
                ["gresource", "extract", lib, resource],
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError:
            break                        # gresource is not installed; stop trying
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout
    raise SystemExit(
        f"cannot read {resource} from {library}: install PyGObject with its Gtk "
        f"{version} typelib (e.g. python-gobject) or glib2's 'gresource' tool"
    )


def load_gtk4_base_css(mode: str) -> str:
    """Read the stock Adwaita stylesheet that ships inside GTK4."""
    return load_resource(GTK4_LIGHT_BASE if mode == "light" else GTK4_DARK_BASE, "libgtk-4")


def build_tables(colours: dict[str, str], mode: str) -> tuple[dict[str, str], dict[str, str]]:
    """Adwaita literal colour -> Omarchy colour, per property family.

    Only Adwaita's own palette entries are listed here; everything is derived
    from the active Omarchy palette, nothing is hard-coded to a theme.
    """
    background = colours["background"]
    base = colours["base"]
    border = colours["border"]
    card = colours["card"]
    foreground = colours["foreground"]
    muted = colours["muted"]
    accent = colours["accent"]
    accent_fg = colours["accent_fg"]
    success = colours["success"]
    warning = colours["warning"]
    error = colours["error"]
    blue = pick_raw(colours)

    if mode == "dark":
        surface = {
            "#353535": background,                     # window background
            "#303030": mix(base, background, 0.35),    # unfocused base
            "#2d2d2d": base,                           # views, entries, lists
            "#323232": mix(base, background, 0.5),     # insensitive background
            "#313131": mix(base, background, 0.45),    # text view border
            "#373737": mix(background, foreground, 0.10),  # button hover
            "#282828": mix(border, base, 0.6),
            "#262626": mix(border, background, 0.45),  # titlebar/headerbar
            "#202020": mix(border, base, 0.35),        # backdrop shade
            "#1e1e1e": mix(border, base, 0.25),        # button active
            "#1b1b1b": border,                         # borders, dark shade
            "#070707": mix(border, "#000000", 0.5),    # button outline shadow
            "#15539e": accent,                         # selected background
            "#0f3b71": mix(accent, border, 0.5),       # selected (darker) / rubberband
            "#1b6acb": mix(accent, background, 0.25),  # visited link
            "#030c17": mix(accent, border, 0.7),       # focus ring
            "#4e9a06": success,
            "#f57900": warning,
            "#cc0000": error,
            "#851015": mix(error, background, 0.35),   # destructive button
            "#1a0000": mix(error, "#000000", 0.7),     # error background
            "#eeeeec": foreground,                     # legacy fallback
            "#919190": muted,
            "#8a8a89": muted,
            "#8e8e8d": muted,
            "#5b5b5b": mix(muted, base, 0.45),         # disabled text
            "#d6d6d6": mix(foreground, background, 0.25),
            "#ffffff": accent_fg,
            "white": accent_fg,
            "black": mix(border, "#000000", 0.5),
        }
        text = {
            "#eeeeec": foreground,
            "#ffffff": accent_fg,
            "#353535": background,
            "#2d2d2d": base,
            "white": foreground,
            "black": background,
            "#919190": muted,
            "#8a8a89": muted,
            "#8e8e8d": muted,
            "#5b5b5b": mix(muted, base, 0.45),
            "#d6d6d6": mix(foreground, background, 0.25),
            "#15539e": accent,
            "#1b6acb": blue,
            "#cc0000": error,
            "#f57900": warning,
            "#4e9a06": success,
        }
    else:
        surface = {
            "#f6f5f4": background,                     # window background
            "#faf9f8": mix(background, base, 0.5),     # disabled surface
            "#fcfcfc": mix(background, base, 0.75),    # backdrop base
            "#ffffff": base,                           # views, entries, lists
            "#f8f8f7": mix(base, background, 0.4),     # button hover
            "#edebe9": mix(base, background, 0.5),     # button
            "#e4e4e0": mix(base, background, 0.6),     # button backdrop
            "#dfdcd8": mix(base, background, 0.7),     # button active
            "#d6d1cd": mix(base, background, 0.8),
            "#cdc7c2": border,                         # borders
            "#d5d0cc": mix(border, base, 0.4),         # backdrop borders
            "#d4cfca": mix(border, base, 0.5),         # disabled borders
            "#bfb8b1": mix(border, foreground, 0.2),   # button outline
            "#3584e4": accent,                         # accent
            "#2f80e3": mix(accent, background, 0.12),
            "#1b6acb": mix(accent, border, 0.35),
            "#185fb4": mix(accent, border, 0.5),
            "#15539e": mix(accent, border, 0.6),
            "#4e9a06": success,
            "#f57900": warning,
            "#cc0000": error,
            "#e01b24": error,
            "#2e3436": foreground,                     # legacy fallback
            "#929595": muted,
            "#fafafa": mix(background, base, 0.5),     # sidebar surface
            "#fbfafa": mix(background, base, 0.5),
            "#d4cfca": mix(border, base, 0.5),         # disabled borders/text
            "#dcdde1": mix(base, background, 0.3),
            "#e9eaee": mix(base, background, 0.2),
            "#e1dedb": mix(base, background, 0.6),
            "#818284": muted,
            "white": base,
            "black": mix(border, "#000000", 0.4),
        }
        text = {
            "#2e3436": foreground,
            "#ffffff": accent_fg,
            "#f6f5f4": background,
            "#fcfcfc": base,
            "white": accent_fg,
            "black": foreground,
            "#929595": muted,
            "#919190": muted,
            "#3584e4": accent,
            "#1b6acb": blue,
            "#185fb4": blue,
            "#15539e": accent_fg,
            "#cc0000": error,
            "#e01b24": error,
            "#f57900": warning,
            "#4e9a06": success,
            "#353535": foreground,
            "#323232": foreground,
        }
    return surface, text


def pick_raw(colours: dict[str, str]) -> str:
    """Link colour: prefer the palette's blue, else the accent."""
    return colours.get("link", colours["accent"])


def _anchors(table: dict[str, str]) -> list[tuple[tuple[int, int, int], str]]:
    """Colour anchors used to classify palette entries the table does not list."""
    anchors = []
    for colour, target in table.items():
        rgb = hex_to_rgb(colour)
        if rgb:
            anchors.append((rgb, target))
    return anchors


def _nearest(rgb: tuple[int, int, int], anchors: list[tuple[tuple[int, int, int], str]]) -> str | None:
    best: tuple[int, str] | None = None
    for anchor_rgb, target in anchors:
        distance = sum((a - b) ** 2 for a, b in zip(rgb, anchor_rgb))
        if best is None or distance < best[0]:
            best = (distance, target)
    return best[1] if best else None


def hue_of(rgb: tuple[int, int, int]) -> float:
    r, g, b = rgb
    high, low = max(rgb), min(rgb)
    if high == low:
        return -1.0
    delta = high - low
    if high == r:
        hue = (60 * ((g - b) / delta)) % 360
    elif high == g:
        hue = 60 * ((b - r) / delta) + 120
    else:
        hue = 60 * ((r - g) / delta) + 240
    return hue


def chromatic_target(rgb: tuple[int, int, int], colours: dict[str, str]) -> str | None:
    """Map a saturated Adwaita colour onto the closest Omarchy hue."""
    if max(rgb) - min(rgb) < 40:
        return None
    source_hue = hue_of(rgb)
    if source_hue < 0:
        return None
    best: tuple[float, str] | None = None
    for key in ("red", "orange", "yellow", "green", "cyan", "blue", "magenta", "brown"):
        candidate = colours.get(key)
        candidate_rgb = hex_to_rgb(candidate or "")
        if candidate_rgb is None:
            continue
        delta = abs(source_hue - hue_of(candidate_rgb))
        delta = min(delta, 360 - delta)
        if best is None or delta < best[0]:
            best = (delta, candidate or "")
    if best is None:
        return None
    target = best[1]
    source_light = luminance("#%02x%02x%02x" % rgb)
    target_light = luminance(target)
    if source_light < target_light - 0.05:
        return mix(target, colours["border"], 0.45)
    if source_light > target_light + 0.20:
        return mix(target, colours["foreground"], 0.30)
    return target


def substitute(
    value: str,
    table: dict[str, str],
    anchors: list[tuple[tuple[int, int, int], str]],
    colours: dict[str, str],
) -> str:
    def repl(match: re.Match[str]) -> str:
        token = match.group(0)
        key = token.lower()
        if key in table:
            return table[key]
        rgb = hex_to_rgb(token)
        if rgb is not None:
            # Leave near-black / near-white extremes alone: those are neutrals
            # (shadows, pure black outlines) rather than palette entries.
            if max(rgb) < 0x20 or min(rgb) > 0xF6:
                return token
            chromatic = chromatic_target(rgb, colours)
            if chromatic:
                return chromatic
            nearest = _nearest(rgb, anchors)
            if nearest:
                return nearest
        return token

    value = re.sub(r"#[0-9a-fA-F]{6}", repl, value)
    return re.sub(r"\b(white|black)\b", repl, value)


def recolor(css: str, surface: dict[str, str], text: dict[str, str], colours: dict[str, str]) -> str:
    """Swap Adwaita's palette entries, leaving every rule structure intact."""
    surface_anchors = _anchors(surface)
    text_anchors = _anchors(text)

    def on_declaration(match: re.Match[str]) -> str:
        prop, value = match.group(1), match.group(2)
        if prop in FOREGROUND_PROPERTIES:
            return f"{prop}:{substitute(value, text, text_anchors, colours)};"
        return f"{prop}:{substitute(value, surface, surface_anchors, colours)};"

    css = re.sub(r"([-a-zA-Z]+)\s*:\s*([^;{}]+);", on_declaration, css)

    def on_define(match: re.Match[str]) -> str:
        name, value = match.group(1), match.group(2)
        if name in FOREGROUND_DEFINES:
            return f"@define-color {name} {substitute(value, text, text_anchors, colours)};"
        return f"@define-color {name} {substitute(value, surface, surface_anchors, colours)};"

    return re.sub(r"@define-color\s+([-a-zA-Z_]+)\s+([^;]+);", on_define, css)


def resolve_assets(css: str, prefix: str) -> str:
    """Point relative 'assets/...' references at libgtk's bundled artwork."""

    def repl(match: re.Match[str]) -> str:
        return f'url("resource://{prefix}{match.group(1)}")'

    return re.sub(r'url\(\s*"assets/([^"]+)"\s*\)', repl, css)


def build_mapping(palette: dict[str, str]) -> dict[str, str]:
    """Map Omarchy colour names onto the semantic roles GTK/Adwaita uses."""
    accent = pick(palette, "accent", "blue", fallback="#3584e4")
    return {
        "background": pick(palette, "background", "bg", fallback="#353535"),
        "base": pick(palette, "dark_background", "dark_bg", "background", fallback="#2d2d2d"),
        "sidebar": pick(palette, "darker_background", "darker_bg", "dark_background", fallback="#1b1b1b"),
        "card": pick(palette, "lighter_background", "lighter_bg", "selection", fallback="#3e4148"),
        "foreground": pick(palette, "foreground", "fg", fallback="#eeeeec"),
        "muted": pick(palette, "muted", "dark_foreground", "foreground", fallback="#808080"),
        "accent": accent,
        "accent_fg": readable_on(accent),
        "border": pick(palette, "darker_background", "darker_bg", "border", fallback="#1b1b1b"),
        "error": pick(palette, "red", "bright_red", fallback="#e01b24"),
        "success": pick(palette, "green", "bright_green", fallback="#2ec27e"),
        "warning": pick(palette, "yellow", "bright_yellow", fallback="#e5a50a"),
        "selection": pick(palette, "selection", "lighter_background", fallback="#3e4148"),
        "link": pick(palette, "blue", "bright_blue", fallback=accent),
        "red": pick(palette, "red", "bright_red", fallback="#e01b24"),
        "orange": pick(palette, "orange", fallback="#ff7800"),
        "yellow": pick(palette, "yellow", "bright_yellow", fallback="#f5c211"),
        "green": pick(palette, "green", "bright_green", fallback="#33d17a"),
        "cyan": pick(palette, "cyan", "bright_cyan", fallback="#33c7de"),
        "blue": pick(palette, "blue", "bright_blue", fallback=accent),
        "magenta": pick(palette, "magenta", "bright_magenta", fallback="#c061cb"),
        "brown": pick(palette, "brown", fallback="#986a44"),
    }


def render_css(colors_file: Path, palette: dict[str, str], mode: str) -> str:
    colours = build_mapping(palette)
    name_file = XDG_STATE_HOME / "omarchy/current/theme.name"
    theme_name = name_file.read_text(encoding="utf-8").strip() if name_file.exists() else "active"
    shadow_alpha = 0.20 if mode == "light" else 0.45

    surface, text = build_tables(colours, mode)
    body = recolor(load_base_css(mode), surface, text, colours)
    body = resolve_assets(body, GTK3_ASSET_PREFIX)

    comment = [
        f"/* {MARKER}; do not edit. */",
        f"/* Source: {colors_file}",
        f"   Theme: {theme_name} (mode: {mode})",
        "   The stock Adwaita stylesheet with only its palette entries replaced",
        "   by Omarchy colours: every rule, state, size and behaviour is",
        "   Adwaita's own, so widget geometry and accessibility are unchanged.",
        "   Regenerated by omarchy-adwaita-gtk on every Omarchy theme change. */",
        "",
    ]
    defines = [
        "/* --- GTK palette roles (authoritative values) ----------------------- */",
        f"@define-color theme_bg_color {colours['background']};",
        f"@define-color theme_fg_color {colours['foreground']};",
        f"@define-color theme_base_color {colours['base']};",
        f"@define-color theme_text_color {colours['foreground']};",
        f"@define-color theme_selected_bg_color {colours['accent']};",
        f"@define-color theme_selected_fg_color {colours['accent_fg']};",
        f"@define-color theme_unfocused_bg_color {colours['background']};",
        f"@define-color theme_unfocused_fg_color {colours['muted']};",
        f"@define-color theme_unfocused_base_color {colours['base']};",
        f"@define-color theme_unfocused_text_color {colours['muted']};",
        f"@define-color theme_unfocused_selected_bg_color {colours['accent']};",
        f"@define-color theme_unfocused_selected_fg_color {colours['accent_fg']};",
        f"@define-color insensitive_bg_color {mix(colours['base'], colours['background'], 0.5)};",
        f"@define-color insensitive_fg_color {colours['muted']};",
        f"@define-color insensitive_base_color {colours['base']};",
        f"@define-color unfocused_insensitive_color {mix(colours['muted'], colours['base'], 0.45)};",
        f"@define-color borders {colours['border']};",
        f"@define-color unfocused_borders {mix(colours['border'], colours['base'], 0.35)};",
        f"@define-color warning_color {colours['warning']};",
        f"@define-color error_color {colours['error']};",
        f"@define-color success_color {colours['success']};",
        f"@define-color content_view_bg {colours['base']};",
        f"@define-color text_view_bg {colours['base']};",
        f"@define-color wm_bg_a {mix(colours['background'], colours['foreground'], 0.04)};",
        f"@define-color wm_bg_b {colours['background']};",
        f"@define-color wm_title {colours['foreground']};",
        f"@define-color wm_unfocused_title {colours['muted']};",
        f"@define-color wm_borders_edge {rgba(colours['foreground'], 0.07)};",
        f"@define-color wm_highlight rgba(255,255,255,{0.04 if mode == 'dark' else 0.10:.2f});",
        f"@define-color wm_shadow rgba(0,0,0,{shadow_alpha:.2f});",
        "",
        "/* --- Omarchy semantic aliases (for applications that want them) ----- */",
        f"@define-color omarchy_background {colours['background']};",
        f"@define-color omarchy_base {colours['base']};",
        f"@define-color omarchy_sidebar {colours['sidebar']};",
        f"@define-color omarchy_card {colours['card']};",
        f"@define-color omarchy_foreground {colours['foreground']};",
        f"@define-color omarchy_muted {colours['muted']};",
        f"@define-color omarchy_accent {colours['accent']};",
        f"@define-color omarchy_accent_fg {colours['accent_fg']};",
        f"@define-color omarchy_selection {colours['selection']};",
        f"@define-color omarchy_error {colours['error']};",
        f"@define-color omarchy_success {colours['success']};",
        f"@define-color omarchy_warning {colours['warning']};",
        "",
    ]
    return "\n".join(comment) + body + "\n" + "\n".join(defines)


